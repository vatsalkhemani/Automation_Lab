# --- AI News Digest ---
# Copy this file to .env and fill in your values.
# For GitHub Actions, add these as repository secrets.

# NewsAPI.org API key (free tier: 100 requests/day)
# Get one at: https://newsapi.org/register
NEWSAPI_KEY=

# Google Gemini API key (free tier: 15 RPM, 1M tokens/day)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gmail address to send FROM (must have 2FA + App Password enabled)
GMAIL_ADDRESS=

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Email address(es) to send the digest TO.
# Single recipient:  EMAIL_RECIPIENT=alice@example.com
# Multiple (comma-separated, delivered via BCC so addresses stay private):
#   EMAIL_RECIPIENT=alice@example.com,bob@example.com,carol@example.com
EMAIL_RECIPIENT=
